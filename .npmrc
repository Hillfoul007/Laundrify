# Prevent Rollup and optional dependency issues
fund=false
audit=false
progress=false
optional=false
# Reduce parallel downloads to conserve memory
maxsockets=1
# Use faster registry
registry=https://registry.npmjs.org/
# Use legacy peer deps to avoid conflicts
legacy-peer-deps=true
# Strict SSL to prevent package corruption
strict-ssl=true
# Disable package locks to prevent conflicts
package-lock=false
